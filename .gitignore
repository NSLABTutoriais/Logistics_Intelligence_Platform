# Ambiente virtual
.venv/

# Cache e arquivos compilados do Python
__pycache__/
*.py[cod]

# Configuracoes locais do VS Code
.vscode/

# Arquivos locais de ambiente e credenciais
.env
.env.*
!.env.example

# Datasets originais - nao versionar no Git
/data/raw/
/data/silver/

# Power BI - arquivos locais e cache
**/.pbi/

# MLflow - banco de dados e artefatos locais
/mlruns/

# Resultados analiticos de Machine Learning
/data/ml_results/

# Documentacao - PDFs locais nao versionados
/docs/*.pdf
