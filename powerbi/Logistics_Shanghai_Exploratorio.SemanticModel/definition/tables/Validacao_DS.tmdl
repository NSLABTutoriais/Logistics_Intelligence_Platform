	partition Validacao_DS = m
		mode: import
		source =
				let
				    Fonte = #"pickup_sh-00000-of-00001-79fabe8088e723a2",
				    #"Personalização Adicionada" = Table.AddColumn(Fonte, "validacao_ds", each if [ds] = null or [accept_time] = null then
				    "SEM_DADOS"
				else
				    let
				        mes = Number.FromText(Text.Start([accept_time], 2)),
				        dia = Number.FromText(Text.Range([accept_time], 3, 2)),
				        dsCalculado = mes * 100 + dia
				    in
				        if [ds] = dsCalculado then
				            "OK"
				        else
				            "DIVERGENTE")
				in
				    #"Personalização Adicionada"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

